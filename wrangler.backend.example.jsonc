// Template only. Create the real D1 binding and approved account configuration
// before selecting this file. Do not deploy with placeholder identifiers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exactmec-website",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "send_email": [{"name":"EMAIL","destination_address":"sales@exactmec.com","allowed_sender_addresses":["sales@exactmec.com"]}],
  "assets": {"directory":"./dist/public","binding":"ASSETS","html_handling":"none","not_found_handling":"none","run_worker_first":true},
  "d1_databases": [{"binding":"DB","database_name":"exactmec-leads","database_id":"REPLACE_WITH_CREATED_D1_ID","migrations_dir":"migrations"}],
  "vars": {
    "SITE_ORIGIN":"https://exactmec.com",
    "RELEASE":"false",
    "LEGAL_APPROVED":"false",
    "COLLECTION_ENABLED":"false",
    "NOTIFICATIONS_ENABLED":"false",
    "NOTIFY_TO":"sales@exactmec.com",
    "NOTIFY_FROM":"sales@exactmec.com",
    "NOTICE_VERSION":"",
    "PRIVACY_VERSION":"",
    "PROCESSING_BASIS":"",
    "WHATSAPP_NOTICE_VERSION":""
  }
  // Sender/recipient selected and basic mailbox verification completed.
  // Keep collection disabled until legal and protected admin release checks pass.
  // A scheduled maintenance trigger may clean expired rate buckets; select
  // and verify that schedule before enabling it in the account.
}
