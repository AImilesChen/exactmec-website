# Public build values only. Never store API tokens in VITE_* variables.
VITE_SITE_ORIGIN=https://exactmec.com
VITE_CONTACT_EMAIL=sales@exactmec.com
VITE_CONTACT_EMAIL_VERIFIED=false
VITE_SITE_RELEASE=false
VITE_LEGAL_APPROVED=false
VITE_BACKEND_VERIFIED=false
VITE_INQUIRY_ENABLED=false
# Optional external measurement is independent of collection/release gates.
# Only enable after configuring matching Worker EXTERNAL_ANALYTICS_ENABLED.
VITE_EXTERNAL_ANALYTICS_ENABLED=false
# The confirmed public WhatsApp business number is in src/site-config.mjs.
# Cloudflare/GitHub credentials belong in their platform secrets, never this file.
