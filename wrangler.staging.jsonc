{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exactmec-staging",
  "account_id": "77bc392d46985cd3425691358f5e8a77",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {"directory":"./dist/public","binding":"ASSETS","html_handling":"none","not_found_handling":"none","run_worker_first":true},
  "d1_databases": [{"binding":"DB","database_name":"exactmec-leads","database_id":"b146b465-837e-479a-9041-01593d3abad3","migrations_dir":"migrations"}],
  "vars": {
    "SITE_ORIGIN":"https://exactmec.com",
    "RELEASE":"false",
    "LEGAL_APPROVED":"false",
    "COLLECTION_ENABLED":"false",
    "NOTIFICATIONS_ENABLED":"false",
    "NOTIFY_TO":"",
    "NOTIFY_FROM":"",
    "NOTICE_VERSION":"",
    "PRIVACY_VERSION":"",
    "PROCESSING_BASIS":"",
    "WHATSAPP_NOTICE_VERSION":""
  }
}
