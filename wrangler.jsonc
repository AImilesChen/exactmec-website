{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exactmec-website",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {"RELEASE": "false", "LEGAL_APPROVED": "false", "SITE_ORIGIN": "https://exactmec.com", "COLLECTION_ENABLED": "false"}
}
