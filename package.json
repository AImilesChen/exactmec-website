{
  "name": "exactmec-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.frontend.config.mjs",
    "build": "node scripts/build-frontend.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "build:release": "node scripts/build-frontend.mjs --release",
    "preview:frontend": "node scripts/serve-frontend.mjs",
    "test:frontend": "node --test tests/frontend-*.test.mjs tests/inquiry-*.test.mjs tests/analytics-*.test.mjs tests/cloudflare-*.test.mjs src/customer/*.test.mjs",
    "check:frontend": "npm run build:frontend && npm run test:frontend",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "verify:live:seo": "node scripts/verify-live-seo.mjs",
    "smoke:frontend": "node scripts/smoke-frontend.mjs",
    "dev:review": "vite",
    "build:review": "vite build && node scripts/prepare-sites-build.mjs",
    "dev:integration": "node scripts/serve-backend-local.mjs",
    "test:backend": "node --test tests/backend-*.test.mjs tests/admin-client*.test.mjs src/admin/content-client.test.mjs tests/customer-portal-integration.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "jose": "6.2.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "miniflare": "5.20261019.2-beta",
    "sharp": "^0.35.5",
    "wrangler": "4.152.0"
  }
}
